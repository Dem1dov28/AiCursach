# LLM (OpenRouter или OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:19407
OPENROUTER_APP_NAME=AiCursach

# Порты (нестандартные, чтобы не конфликтовать с другими приложениями)
WEB_HOST=0.0.0.0
WEB_PORT=19407

# PostgreSQL (Docker: bash scripts/start-db.sh)
DATABASE_URL=postgresql://bsuir:bsuir@localhost:54329/bsuir_work
POSTGRES_PORT=54329

AICURSACH_DATA_DIR=data
AICURSACH_USE_SERVER_STORAGE=1

# LangGraph
GRAPH_RECURSION_LIMIT=80
MAX_REVISIONS=3

# Альтернатива: прямой OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Веб-поиск для Researcher (опционально, https://tavily.com)
TAVILY_API_KEY=

# Академический поиск Researcher (OpenAlex — без ключа; email для polite pool)
OPENALEX_MAILTO=
# SEMANTIC_SCHOLAR_API_KEY=

# Проверка DOI в списке литературы через CrossRef (1=вкл, 0=выкл)
CROSSREF_VERIFY=1

# Скриншоты HTML-проектов (опционально)
# CHROME_PATH=/usr/bin/google-chrome
# CHROMIUM_FLAGS=--no-sandbox --disable-dev-shm-usage

# Переопределение стоимости токенов LLM (USD за токен, опционально)
# LLM_INPUT_USD_PER_TOKEN=0.0000004
# LLM_OUTPUT_USD_PER_TOKEN=0.0000016
