@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Times New Roman

actor "Жертвователь" as Donor
actor "Оператор фонда" as Operator
actor "Администратор" as Admin
actor "Публичный\nпользователь" as Public

rectangle "CharityLedger" {
  usecase "Просмотр кампаний" as UC1
  usecase "Регистрация пожертвования" as UC2
  usecase "Просмотр публичных отчётов" as UC3
  usecase "Учёт расходов" as UC4
  usecase "Публикация отчёта прозрачности" as UC5
  usecase "Аутентификация" as UC6
  usecase "Управление кампаниями" as UC7
}

Donor --> UC1
Donor --> UC2
Public --> UC1
Public --> UC3
Operator --> UC6
Operator --> UC4
Operator --> UC5
Admin --> UC6
Admin --> UC7
UC2 ..> UC1 : <<include>>
UC5 ..> UC4 : <<extend>>
@enduml
